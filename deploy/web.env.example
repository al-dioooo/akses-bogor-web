# Contoh /etc/akses-bogor/web.env di Evergarden (ADR-0048). Berkas aslinya tidak di-commit.
# Pemilik root:aksesbogor-web, mode 0640. Dibaca akses-bogor-web.service saat runtime dan deploy.sh saat build.
# NEXT_PUBLIC_*, SITE_URL, dan SITE_INDEXABLE ikut menentukan hasil build, jadi perubahan nilainya baru berlaku penuh
# setelah deploy ulang (lihat README bagian Deployment).
NODE_ENV=production
# Port di 127.0.0.1; alamatnya dikunci di akses-bogor-web.service. 8090 dipakai API.
PORT=8091
# Tanpa telemetri Next.js dari server.
NEXT_TELEMETRY_DISABLED=1

# Alamat akses-bogor-api, hanya dipanggil dari server web.
API_URL=https://akses-bogor-api.aldio.dev
# Alamat situs untuk URL kanonis, OpenGraph, sitemap, dan robots.txt. Wajib: deploy.sh menolak build tanpa ini.
SITE_URL=https://akses-bogor.aldio.dev
# Staging tidak boleh diindeks sampai domain produksi dipilih (ADR-0045).
SITE_INDEXABLE=false

# Client ID OAuth Google (bukan rahasia), sama dengan GOOGLE_CLIENT_ID di API. Kosong berarti tombol "Masuk dengan
# Google" tidak tampil.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Rahasia bersama dengan API, diisi sendiri dengan nilai yang sama seperti WEB_SERVER_SECRET di
# /etc/akses-bogor/api.env. Tanpa ini, IP pengunjung tidak dikirim, dan semua pengunjung berbagi kuota rate limit satu
# IP server.
WEB_SERVER_SECRET=
