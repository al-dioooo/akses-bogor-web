# Salin ke .env.local lalu isi. Jangan commit .env*.

# Alamat akses-bogor-api. Hanya dibaca di server Next.js, tidak dikirim ke browser.
API_URL=http://localhost:8080

# Client ID OAuth Google (bukan rahasia), sama dengan GOOGLE_CLIENT_ID di API (ADR-0029). Kosong berarti tombol
# "Masuk dengan Google" tidak tampil dan pengguna masuk dengan kode email.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Rahasia bersama dengan akses-bogor-api, sama dengan WEB_SERVER_SECRET di API, minimal 32 karakter. Dengan ini web
# mengirim IP pengunjung, jadi rate limit API dihitung per pengunjung. Kosongkan untuk pengembangan lokal.
WEB_SERVER_SECRET=

# Alamat situs tanpa path, untuk URL kanonis, OpenGraph, sitemap, dan robots.txt. Kosong berarti domain Vercel, lalu
# http://localhost:3000.
SITE_URL=

# true supaya halaman publik boleh diindeks mesin pencari (butuh SITE_URL). Kosong: semua halaman noindex.
SITE_INDEXABLE=
