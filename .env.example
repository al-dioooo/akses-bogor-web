# Salin ke .env.local lalu isi. Jangan commit .env*.

# Alamat akses-bogor-api. Hanya dibaca di server Next.js, tidak dikirim ke browser.
API_URL=http://localhost:8080

# Client ID OAuth Google (bukan rahasia), sama dengan GOOGLE_CLIENT_ID di API (ADR-0029). Kosong berarti tombol
# "Masuk dengan Google" tidak tampil dan pengguna masuk dengan kode email.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
